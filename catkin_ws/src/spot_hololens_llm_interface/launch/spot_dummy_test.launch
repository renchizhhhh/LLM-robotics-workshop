<launch>
    <!-- Dummy mode test launch file - no real robot needed -->
    <!-- Perfect for testing FSM logic and state transitions -->
    <!-- 
    Usage:
    1. Run this launch file: roslaunch spot_hololens_llm_interface spot_dummy_test.launch
l       2. In second terminal: rosrun spot_hololens_llm_interface test_real_spot_manager.py
    -->
    
    <!-- Parameters -->
    <arg name="verbose" default="false" />
    <arg name="dummy_mode" default="true" />
    <!-- Dummy Estop ROS node - provides estop services without real robot -->
    <node
        pkg="spot_hololens_llm_interface"
        type="estop_ros_node.py"
        name="estop_node"
        output="screen">
        <param name="dummy_mode" value="$(arg dummy_mode)"/>
        <param name="timeout" value="4.0"/>
        <param name="hostname" value="192.168.1.109"/>  <!-- Dummy hostname for dummy mode -->
    </node>

    <!-- Spot Robot Manager in dummy mode - provides all services without real robot -->
    <node name="spot_entrance" pkg="spot_hololens_llm_interface" type="spot_entrance.py" output="screen">
        <param name="dummy_mode" value="$(arg dummy_mode)"/>
        <param name="hostname" value="192.168.1.109"/>  <!-- Dummy hostname for dummy mode -->
        <param name="ready_for_command" value="false"/>
        <param name="verbose" value="$(arg verbose)"/>
    </node>
    
    
    <!-- orchestra in dummy mode - DISABLED to prevent conflicts with nl_control -->
    <!-- <node name="spot_orchestrator" pkg="spot_hololens_llm_interface" type="experiment_orchestrator.py" output="screen">
        <param name="dummy_mode" value="$(arg dummy_mode)"/>
        <param name="mode" value="HA"/>
    </node> -->

    <!-- Spot Robot Simulation GUI for dummy mode -->
    <node if="$(arg dummy_mode)" name="spot_simulation_gui" pkg="spot_hololens_llm_interface" type="spot_simulation_gui.py" output="screen">
    </node>

    <!-- Natural Language Control for dummy mode -->
    <node if="$(arg dummy_mode)" name="nl_control" pkg="spot_hololens_llm_interface" type="nl_control_gemini_no_world.py" output="screen">
        <param name="world_id" value="1"/>
    </node>

    <!-- HoloLens Unity ROS TCP Endpoint -->
    <arg name="tcp_ip" default="0.0.0.0"/>
    <arg name="tcp_port" default="10000"/>
    <rosparam param="ROS_IP">0.0.0.0</rosparam>
    <node name="unity_endpoint" pkg="ros_tcp_endpoint" type="default_server_endpoint.py" output="screen">
        <param name="tcp_ip" type="string" value="$(arg tcp_ip)"/>
        <param name="tcp_port" type="int" value="$(arg tcp_port)"/>
    </node>
    
</launch>
