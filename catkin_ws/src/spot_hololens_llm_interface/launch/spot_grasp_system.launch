<launch>
    <!-- Spot robot parameters -->
    <arg name="hostname" default="192.168.80.3" doc="Spot robot IP address"/>
    <arg name="verbose" default="false" doc="Enable verbose logging"/>
    
    <!-- Spot entrance node - manages robot connection and basic operations -->
    <node name="spot_entrance" pkg="spot_hololens_llm_interface" type="spot_entrance.py" output="screen">
        <param name="hostname" value="$(arg hostname)"/>
        <param name="verbose" value="$(arg verbose)"/>
        <rosparam param="hostname" subst_value="True">$(arg hostname)</rosparam>
    </node>
    
    <!-- Spot grasp action server - provides ROS actions for grasping -->
    <node name="spot_grasp_action_server" pkg="spot_hololens_llm_interface" type="spot_grasp_action_server_v2.py" output="screen"/>
    
</launch>
